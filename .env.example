# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL and publishable (anon) key: Project Settings → API Keys.
# Safe in the browser because every table uses Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Not needed in Phase 1. Server-only; never expose in the browser.
# SUPABASE_SECRET_KEY=
# Only for applying migrations with the Supabase CLI.
# SUPABASE_DB_PASSWORD=
